{
  "schemaVersion": "1.0",
  "configId": "mbddf-memperf",
  "productModel": "MB_DDF_v2",
  "productName": "MB_DDF memory performance",
  "configVersion": "1.0.0",
  "steps": [
    {
      "stepId": "MEMPERF_TEST",
      "testItemId": "memperf",
      "name": "内存校验与性能",
      "type": "EXCHANGE",
      "algorithmId": "mbddf.memperf",
      "parameters": {
        "protocol": {
          "requestValues": {
            "memperf_type": 0,
            "length": 65536,
            "seed": 1515870810
          }
        }
      },
      "timeoutMs": 120000,
      "retryCount": 0,
      "enabled": true,
      "dependsOn": [],
      "criteria": [
        {"metric": "status", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "err_code", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "error_count", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true}
      ]
    }
  ],
  "hardwareRequirements": [],
  "protocolProfiles": [
    {"id": "memperf_test_request", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 120000}},
    {"id": "memperf_test_response", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 120000}}
  ],
  "executionConfig": {
    "protocolAssetRoot": "${MB_DDF_PROTOCOL_CSV_DIR}",
    "protocol": {"requestProfileId": "memperf_test_request", "responseProfileId": "memperf_test_response"},
    "transport": {"openTimeoutMs": 1000, "readChunkBytes": 260},
    "initialSequence": 4660
  },
  "safetyPolicy": {"enterSafeStateOnStop": true, "enterSafeStateOnError": true},
  "runtimeConfig": {"parallelEnabled": false, "maxParallel": 1, "defaultTimeoutMs": 120000, "defaultRetryCount": 0, "retryIntervalMs": 0, "taskPriorityDefault": 2, "stopOnFirstFailure": true, "allowResume": false},
  "reportFields": {
    "title": "内存校验与性能",
    "description": "执行 MB_DDF 内存图样校验或带宽测试。",
    "supportedRunModes": ["single", "pc_periodic"],
    "measurements": [
      {"id": "status", "label": "设备状态", "unit": "", "primary": false},
      {"id": "err_code", "label": "设备错误码", "unit": "", "primary": false},
      {"id": "memperf_type", "label": "测试类型", "unit": "", "primary": false},
      {"id": "error_count", "label": "错误计数", "unit": "", "primary": true},
      {"id": "first_fail_addr", "label": "首个错误地址", "unit": "byte", "primary": false},
      {"id": "elapsed_ms", "label": "执行耗时", "unit": "ms", "primary": true},
      {"id": "write_bandwidth", "label": "写带宽", "unit": "MB/s", "primary": true},
      {"id": "read_bandwidth", "label": "读带宽", "unit": "MB/s", "primary": true}
    ]
  }
}

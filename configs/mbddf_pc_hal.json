            {
              "id": "counter-pulse",
              "kind": "counterOutput",
              "mode": "continuous",
              "resources": ["PXI_CTR_1"],
              "counterFrequencyHz": 1000.0,
              "counterDutyCycle": 0.5
            }
          ]
        }
      }

{
  "schemaVersion": "1.0",
  "configId": "mbddf-serial-test",
  "productModel": "MB_DDF_v2",
  "productName": "串口测试",
  "configVersion": "1.0.0",
  "steps": [
    {
      "stepId": "SERIAL_TEST",
      "testItemId": "serial_test",
      "name": "串口测试",
      "type": "EXCHANGE",
      "algorithmId": "mbddf.serial_test",
      "parameters": {
        "protocol": {
          "requestValues": {
            "test_mode": 0,
            "link_id": 0,
            "cycle_count": 1000,
            "total_count": 1000,
            "data[0]": 77,
            "data[1]": 66,
            "data[2]": 49
          }
        }
      },
      "timeoutMs": 5000,
      "retryCount": 0,
      "enabled": true,
      "dependsOn": [],
      "criteria": [
        {"metric": "status", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "err_code", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "link_id", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "error_count", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "total_count", "op": "Equal", "ref": 1000, "tol": 0, "passIfMatched": true}
      ]
    }
  ],
  "hardwareRequirements": [],
  "protocolProfiles": [
    {"id": "bus_loop_test_request", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 5000}},
    {"id": "bus_loop_test_response", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 5000}},
    {"id": "bus_echo_test_request", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 5000}},
    {"id": "bus_echo_test_response", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 5000}}
  ],
  "executionConfig": {
    "protocolAssetRoot": "${MB_DDF_PROTOCOL_CSV_DIR}",
    "serialTest": {
      "loopback": {
        "requestProfileId": "bus_loop_test_request",
        "responseProfileId": "bus_loop_test_response"
      },
      "echo": {
        "requestProfileId": "bus_echo_test_request",
        "responseProfileId": "bus_echo_test_response"
      }
    },
    "transport": {
      "openTimeoutMs": 1000,
      "readChunkBytes": 260,
      "busEcho": {
        "payloadBytes": 114,
        "resourceByLink": {
          "0": "BUS_ECHO_COM1",
          "1": "BUS_ECHO_COM2",
          "3": "BUS_ECHO_COM4"
        }
      }
    },
    "initialSequence": 4660
  },
  "safetyPolicy": {"enterSafeStateOnStop": true, "enterSafeStateOnError": true},
  "runtimeConfig": {"parallelEnabled": false, "maxParallel": 1, "defaultTimeoutMs": 5000, "defaultRetryCount": 0, "retryIntervalMs": 0, "taskPriorityDefault": 2, "stopOnFirstFailure": true, "allowResume": false},
  "reportFields": {
    "title": "串口测试",
    "description": "选择 COM1、COM2 或 COM4 后，内部回环由 DUT 一次执行全部次数；PC-DUT 回显由独立本地串口逐轮原样回送 119 字节物理帧并校验其中 114 字节 payload。COM3 为控制口。",
    "supportedRunModes": ["single"],
    "measurements": [
      {"id": "status", "label": "设备状态", "unit": "", "primary": false},
      {"id": "err_code", "label": "设备错误码", "unit": "", "primary": false},
      {"id": "link_id", "label": "串口链路", "unit": "", "primary": false},
      {"id": "error_count", "label": "错误次数", "unit": "次", "primary": true},
      {"id": "total_count", "label": "循环次数", "unit": "次", "primary": true},
      {"id": "elapsed_ms", "label": "DUT 执行耗时", "unit": "ms", "primary": true},
      {"id": "echo_bytes", "label": "每轮校验字节数", "unit": "byte", "primary": true},
      {"id": "mismatch_count", "label": "不一致字节数", "unit": "byte", "primary": true},
      {"id": "first_mismatch_index", "label": "首个不一致位置", "unit": "byte", "primary": false},
      {"id": "requested_cycle_count", "label": "请求循环次数", "unit": "次", "primary": true},
      {"id": "completed_cycle_count", "label": "完成轮数", "unit": "次", "primary": true},
      {"id": "failed_cycle_count", "label": "失败轮数", "unit": "次", "primary": false}
    ]
  }
}

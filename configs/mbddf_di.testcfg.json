{
  "schemaVersion": "1.0",
  "configId": "mbddf-di-read",
  "productModel": "MB_DDF_v2",
  "productName": "MB_DDF digital input",
  "configVersion": "1.1.0",
  "steps": [
    {
      "stepId": "DI_READ",
      "testItemId": "di_read",
      "name": "数字量输入回读",
      "type": "EXCHANGE",
      "algorithmId": "mbddf.di_read",
      "parameters": {"protocol": {"requestValues": {}}},
      "timeoutMs": 2000,
      "retryCount": 0,
      "enabled": true,
      "dependsOn": [],
      "criteria": [
        {"metric": "status", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "err_code", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true}
      ]
    }
  ],
  "hardwareRequirements": [
    {
      "requirementId": "pxi6259.digital_stimulus",
      "deviceId": "ni6259_stimulus",
      "adapterId": "ni.daqmx",
      "requiredModules": ["digital"],
      "requiredResources": ["DUT_DI3_STIM", "DUT_DI1_STIM", "DUT_DI2_STIM"],
      "priority": 0,
      "match": {"vendor": "NI", "model": "PXI-6259"}
    }
  ],
  "protocolProfiles": [
    {"id": "di_read_request", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 2000}},
    {"id": "di_read_response", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 2000}}
  ],
  "executionConfig": {
    "protocolAssetRoot": "${MB_DDF_PROTOCOL_CSV_DIR}",
    "protocol": {"requestProfileId": "di_read_request", "responseProfileId": "di_read_response"},
    "transport": {"openTimeoutMs": 1000, "readChunkBytes": 260},
    "initialSequence": 4660,
    "digitalStimulus": {
      "deviceId": "ni6259_stimulus",
      "settlingMs": 20,
      "channels": [
        {"switchId": "di3", "dutBit": 3, "resourceId": "DUT_DI3_STIM", "label": "DI3 PLL锁定", "activeLevel": "High"},
        {"switchId": "di1", "dutBit": 1, "resourceId": "DUT_DI1_STIM", "label": "DI1 保险告警", "activeLevel": "High"},
        {"switchId": "di2", "dutBit": 2, "resourceId": "DUT_DI2_STIM", "label": "DI2 保险点火指令", "activeLevel": "High"}
      ]
    }
  },
  "safetyPolicy": {"enterSafeStateOnStop": true, "enterSafeStateOnError": true},
  "runtimeConfig": {"parallelEnabled": false, "maxParallel": 1, "defaultTimeoutMs": 2000, "defaultRetryCount": 0, "retryIntervalMs": 0, "taskPriorityDefault": 2, "stopOnFirstFailure": true, "allowResume": false},
  "reportFields": {
    "title": "数字量输入",
    "description": "通过 PXI-6259 刺激接线表中的 DI3、DI1、DI2，其余数字输入只做 DUT 总线回读。",
    "supportedRunModes": ["single", "pc_periodic"],
    "measurements": [
      {"id": "status", "label": "设备状态", "unit": "", "primary": false},
      {"id": "err_code", "label": "设备错误码", "unit": "", "primary": false},
      {"id": "di_state[0]", "label": "DI0..DI31 回读位图", "unit": "bitmask", "primary": true},
      {"id": "di_state[1]", "label": "DI32..DI63 诊断位图", "unit": "bitmask", "primary": false}
    ]
  }
}

{
  "schemaVersion": "1.0",
  "configId": "mbddf-di-read",
  "productModel": "MB_DDF_v2",
  "productName": "MB_DDF digital input",
  "configVersion": "1.2.0",
  "steps": [
    {
      "stepId": "DI_READ",
      "testItemId": "di_read",
      "name": "数字量输入回读",
      "type": "EXCHANGE",
      "algorithmId": "mbddf.di_read",
      "parameters": {"protocol": {"requestValues": {}}},
      "timeoutMs": 2000,
      "retryCount": 0,
      "enabled": true,
      "dependsOn": [],
      "criteria": [
        {"metric": "status", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true},
        {"metric": "err_code", "op": "Equal", "ref": 0, "tol": 0, "passIfMatched": true}
      ]
    }
  ],
  "hardwareRequirements": [
    {
      "requirementId": "pxi6259.digital_stimulus",
      "deviceId": "ni6259_stimulus",
      "adapterId": "ni.daqmx",
      "requiredModules": ["digital"],
      "requiredResources": ["DUT_DI3_STIM", "DUT_DI1_STIM", "DUT_DI2_STIM"],
      "priority": 0,
      "match": {"vendor": "NI", "model": "PXI-6259"}
    }
  ],
  "protocolProfiles": [
    {"id": "di_read_request", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 2000}},
    {"id": "di_read_response", "busType": "CONTROL", "payloadEncoding": "raw", "frameFormat": {"header": "55AA", "lengthBytes": 1, "crc": "CRC-16/XMODEM", "crcByteOrder": "little"}, "timing": {"timeoutMs": 2000}}
  ],
  "executionConfig": {
    "protocolAssetRoot": "${MB_DDF_PROTOCOL_CSV_DIR}",
    "protocol": {"requestProfileId": "di_read_request", "responseProfileId": "di_read_response"},
    "transport": {"openTimeoutMs": 1000, "readChunkBytes": 260},
    "initialSequence": 4660,
    "digitalStimulus": {
      "deviceId": "ni6259_stimulus",
      "settlingMs": 20,
      "channels": [
        {"switchId": "di3", "dutBit": 3, "resourceId": "DUT_DI3_STIM", "label": "DI3 锁相环锁定指示", "activeLevel": "High"},
        {"switchId": "di1", "dutBit": 1, "resourceId": "DUT_DI1_STIM", "label": "DI1 引信报警", "activeLevel": "High"},
        {"switchId": "di2", "dutBit": 2, "resourceId": "DUT_DI2_STIM", "label": "DI2 引信起爆指令", "activeLevel": "High"}
      ]
    }
  },
  "safetyPolicy": {"enterSafeStateOnStop": true, "enterSafeStateOnError": true},
  "runtimeConfig": {"parallelEnabled": false, "maxParallel": 1, "defaultTimeoutMs": 2000, "defaultRetryCount": 0, "retryIntervalMs": 0, "taskPriorityDefault": 2, "stopOnFirstFailure": true, "allowResume": false},
  "reportFields": {
    "title": "数字量输入",
    "description": "通过 PXI-6259 刺激接线表中的 DI3、DI1、DI2，其余数字输入只做 DUT 总线回读。",
    "supportedRunModes": ["single", "pc_periodic"],
    "measurements": [
      {"id": "status", "label": "设备状态", "unit": "", "primary": false},
      {"id": "err_code", "label": "设备错误码", "unit": "", "primary": false},
      {"id": "di_state[0]", "label": "DI0..DI31 回读位图", "unit": "bitmask", "primary": true, "taskVisible": false},
      {"id": "di_state[1]", "label": "DI32..DI63 诊断位图", "unit": "bitmask", "primary": false, "taskVisible": false}
    ],
    "taskMeasurements": [
      {"id": "di0", "label": "DI0 联锁、电气弹动", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 0},
      {"id": "di1", "label": "DI1 引信报警", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 1},
      {"id": "di2", "label": "DI2 引信起爆指令", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 2},
      {"id": "di3", "label": "DI3 锁相环锁定指示", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 3},
      {"id": "di4", "label": "DI4", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 4},
      {"id": "di5", "label": "DI5", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 5},
      {"id": "di6", "label": "DI6", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 6},
      {"id": "di7", "label": "DI7", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 7},
      {"id": "di8", "label": "DI8 投放允许", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 8},
      {"id": "di9", "label": "DI9", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 9},
      {"id": "di10", "label": "DI10", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 10},
      {"id": "di11", "label": "DI11", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 11},
      {"id": "di12", "label": "DI12", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 12},
      {"id": "di13", "label": "DI13", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 13},
      {"id": "di14", "label": "DI14", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 14},
      {"id": "di15", "label": "DI15", "unit": "", "primary": true, "sourceId": "di_state[0]", "bitIndex": 15}
    ]
  }
}
